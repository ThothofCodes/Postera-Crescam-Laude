# Backup Configuration
# ====================
# This file contains configuration for MongoDB backup scripts.
# Copy this file to backup.local and customize for your environment.

# ── MongoDB Connection ──────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASS=
MONGO_AUTH_DB=admin
MONGO_DB=

# ── Backup Settings ─────────────────────────────────────────────────────────
BACKUP_DIR=/opt/backups/mongodb
LOG_DIR=/var/log/mongodb-backup
RETENTION_DAYS=30
COMPRESSION=gzip
PARALLEL_JOBS=4

# ── Notification Settings ───────────────────────────────────────────────────
# Enable email notifications for backup status
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_RECIPIENTS=admin@example.com
EMAIL_SUBJECT_PREFIX="[MongoDB Backup]"

# Enable Slack notifications
ENABLE_SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=

# ── Encryption Settings ─────────────────────────────────────────────────────
# Enable encryption for backups
ENABLE_ENCRYPTION=false
ENCRYPTION_KEY_FILE=/etc/backup/encryption.key

# ── Remote Backup Settings ──────────────────────────────────────────────────
# Enable remote backup upload
ENABLE_REMOTE_BACKUP=false
REMOTE_TYPE=s3  # s3, gcs, azure, sftp
REMOTE_BUCKET=your-backup-bucket
REMOTE_PATH=mongodb-backups
REMOTE_REGION=us-east-1

# S3-specific settings
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# GCS-specific settings
GCS_PROJECT_ID=
GCS_KEY_FILE=

# Azure-specific settings
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# SFTP-specific settings
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_KEY_FILE=

# ── Monitoring Settings ─────────────────────────────────────────────────────
# Enable Prometheus metrics
ENABLE_PROMETHEUS_METRICS=false
PROMETHEUS_PORT=9104

# ── Schedule Settings ───────────────────────────────────────────────────────
# Cron schedule for automated backups
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
CLEANUP_SCHEDULE="0 3 * * 0"  # Weekly on Sunday at 3 AM
VERIFY_SCHEDULE="0 4 * * 1"  # Weekly on Monday at 4 AM
