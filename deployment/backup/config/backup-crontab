# MongoDB Backup Crontab
# =====================
# This file contains cron jobs for automated MongoDB backups.
# Install with: crontab deployment/backup/config/backup-crontab
#
# Note: Adjust paths and schedules according to your environment.

# ── Environment Variables ───────────────────────────────────────────────────
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
BACKUP_DIR=/opt/backups/mongodb
LOG_DIR=/var/log/mongodb-backup
MONGO_HOST=localhost
MONGO_PORT=27017

# ── Daily Full Backup (2:00 AM) ────────────────────────────────────────────
# Runs a full backup every day at 2:00 AM
0 2 * * * /opt/pcl/deployment/backup/scripts/scheduled-backup.sh full >> /var/log/mongodb-backup/cron.log 2>&1

# ── Weekly Cleanup (3:00 AM Sunday) ─────────────────────────────────────────
# Removes backups older than 30 days every Sunday at 3:00 AM
0 3 * * 0 /opt/pcl/deployment/backup/scripts/backup.sh cleanup >> /var/log/mongodb-backup/cron.log 2>&1

# ── Weekly Verification (4:00 AM Monday) ───────────────────────────────────
# Verifies all backups from the last week every Monday at 4:00 AM
0 4 * * 1 /opt/pcl/deployment/backup/scripts/verify-backups.sh --verify-days 7 --report /var/log/mongodb-backup/verify_report_$(date +\%Y\%m\%d).json >> /var/log/mongodb-backup/cron.log 2>&1

# ── Monthly Full Verification (5:00 AM 1st of month) ───────────────────────
# Verifies all backups on the 1st of every month at 5:00 AM
0 5 1 * * /opt/pcl/deployment/backup/scripts/verify-backups.sh --verify-all --test-restore --report /var/log/mongodb-backup/verify_report_monthly_$(date +\%Y\%m).json >> /var/log/mongodb-backup/cron.log 2>&1

# ── Log Rotation (6:00 AM Sunday) ──────────────────────────────────────────
# Rotates backup logs every Sunday at 6:00 AM
0 6 * * 0 find /var/log/mongodb-backup -name "*.log" -mtime +30 -delete 2>/dev/null

# ── Disk Space Check (Every 6 hours) ───────────────────────────────────────
# Checks disk space and warns if backup partition is low
0 */6 * * * df -h /opt/backups | awk 'NR==2 {if ($5+0 > 80) print "WARNING: Backup partition " $5 " full"}' | mail -s "[MongoDB Backup] Disk Space Alert" admin@example.com 2>/dev/null
