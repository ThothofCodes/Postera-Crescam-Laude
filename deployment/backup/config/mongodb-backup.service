[Unit]
Description=MongoDB Backup Service
Documentation=file:///opt/pcl/deployment/backup/README.md
After=network.target mongodb.service
Wants=network.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/pcl/deployment/backup
ExecStart=/opt/pcl/deployment/backup/scripts/scheduled-backup.sh full
ExecStartPost=/opt/pcl/deployment/backup/scripts/verify-backups.sh --verify-latest

# Environment
EnvironmentFile=/opt/pcl/deployment/backup/config/backup.env

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/backups/mongodb /var/log/mongodb-backup
PrivateTmp=true

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mongodb-backup

[Install]
WantedBy=multi-user.target
