[Unit]
Description=MongoDB Backup Timer
Documentation=file:///opt/pcl/deployment/backup/README.md

[Timer]
# Run daily at 2:00 AM
OnCalendar=*-*-* 02:00:00
# Run immediately if missed (e.g., system was off)
Persistent=true
# Randomize start time by up to 30 minutes to avoid thundering herd
RandomizedDelaySec=1800
# Accuracy precision
AccuracySec=1min

[Install]
WantedBy=timers.target
