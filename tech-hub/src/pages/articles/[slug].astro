---
import Layout from '../../layouts/Layout.astro';
import { getArticleBySlug } from '../../lib/sanity';

const { slug } = Astro.params;
const article = await getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/articles');
}

const publishedDate = new Date(article.publishedAt).toLocaleDateString('en-KE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${article.title} — PCL Tech Hub`} description={article.excerpt}>
  <main class="article-detail">
    <article class="container">
      <!-- Header -->
      <header class="article-header">
        <a href="/articles" class="back-link">← Back to Articles</a>
        <span class="article-category">{article.category}</span>
        <h1>{article.title}</h1>
        <div class="article-meta">
          {article.author && (
            <div class="author-info">
              {article.author.avatar && (
                <img src={article.author.avatar} alt={article.author.name} class="author-avatar" />
              )}
              <span class="author-name">{article.author.name}</span>
            </div>
          )}
          <time datetime={article.publishedAt}>{publishedDate}</time>
        </div>
        {article.tags && article.tags.length > 0 && (
          <div class="tags">
            {article.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Featured Image -->
      {article.imageUrl && (
        <div class="featured-image">
          <img src={article.imageUrl} alt={article.title} />
        </div>
      )}

      <!-- Body Content -->
      <div class="article-body">
        {article.body?.map((block) => {
          if (block._type === 'block') {
            return (
              <p>{block.children?.map((child) => child.text).join('')}</p>
            );
          }
          if (block._type === 'image') {
            return (
              <figure>
                <img src={block.asset?._url} alt="" loading="lazy" />
              </figure>
            );
          }
          return null;
        })}
      </div>

      <!-- Author Bio -->
      {article.author?.bio && (
        <aside class="author-bio">
          <h3>About the Author</h3>
          <div class="bio-content">
            {article.author.avatar && (
              <img src={article.author.avatar} alt={article.author.name} class="bio-avatar" />
            )}
            <div>
              <strong>{article.author.name}</strong>
              <p>{article.author.bio}</p>
            </div>
          </div>
        </aside>
      )}

      <!-- Related Articles -->
      {article.related && article.related.length > 0 && (
        <section class="related-articles">
          <h2>Related Articles</h2>
          <div class="related-grid">
            {article.related.map((related) => (
              <a href={`/articles/${related.slug?.current}`} class="related-card">
                {related.imageUrl && (
                  <img src={related.imageUrl} alt={related.title} loading="lazy" />
                )}
                <h3>{related.title}</h3>
                <p>{related.excerpt}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</Layout>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }

  .article-detail { padding: 2rem 0; }

  .back-link {
    display: inline-block;
    color: #2BB6A3;
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover { color: #EE6100; }

  .article-header { margin-bottom: 2rem; }

  .article-category {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #2BB6A3;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .article-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: #4a6a8a;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-name { color: #EE6100; font-weight: 600; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .tag {
    padding: 0.25rem 0.75rem;
    background: rgba(43, 182, 163, 0.15);
    border: 1px solid rgba(43, 182, 163, 0.3);
    border-radius: 99px;
    font-size: 0.75rem;
    color: #2BB6A3;
  }

  .featured-image {
    margin-bottom: 2rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #c0d8f0;
  }

  .article-body :global(p) { margin-bottom: 1.25rem; }

  .article-body :global(figure) {
    margin: 2rem 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .article-body :global(img) {
    width: 100%;
    height: auto;
  }

  .author-bio {
    margin-top: 3rem;
    padding: 1.5rem;
    background: #050d0a;
    border: 1px solid rgba(43, 182, 163, 0.2);
    border-radius: 12px;
  }

  .author-bio h3 {
    font-size: 1rem;
    color: #2BB6A3;
    margin-bottom: 1rem;
  }

  .bio-content {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .bio-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .bio-content strong { display: block; margin-bottom: 0.25rem; }
  .bio-content p { font-size: 0.9rem; color: #A9C4BE; }

  .related-articles {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(43, 182, 163, 0.2);
  }

  .related-articles h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .related-card {
    background: #050d0a;
    border: 1px solid rgba(43, 182, 163, 0.2);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  .related-card:hover { border-color: #EE6100; }
  .related-card img { width: 100%; height: 120px; object-fit: cover; }
  .related-card h3 { font-size: 0.9rem; padding: 0.75rem 0.75rem 0.25rem; }
  .related-card p { font-size: 0.8rem; color: #A9C4BE; padding: 0 0.75rem 0.75rem; }
</style>
