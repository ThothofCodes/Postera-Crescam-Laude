---
import Layout from '../layouts/Layout.astro';
import { getArticles, getTechTips, getTechNews, getTechFacts } from '../lib/sanity';

// Fetch homepage data
const [articlesData, tips, news, facts] = await Promise.all([
  getArticles({ limit: 6 }),
  getTechTips({ limit: 5 }),
  getTechNews({ limit: 5 }),
  getTechFacts({ limit: 3 }),
]);

const articles = articlesData.articles || [];
---

<Layout title="PCL Tech Hub — Empowering Kenya's Digital Future">
  <main class="hub-home">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>PCL Tech Hub</h1>
        <p class="tagline">Empowering Kenya's Digital Future</p>
        <p class="subtitle">Tech articles, tips, and news for the modern digital citizen</p>
      </div>
    </section>

    <!-- Featured Articles -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Latest Articles</h2>
        <div class="article-grid">
          {articles.map((article) => (
            <a href={`/articles/${article.slug?.current}`} class="article-card">
              {article.imageUrl && (
                <img src={article.imageUrl} alt={article.title} class="article-image" loading="lazy" />
              )}
              <div class="article-content">
                <span class="article-category">{article.category}</span>
                <h3>{article.title}</h3>
                <p>{article.excerpt}</p>
                <time>{new Date(article.publishedAt).toLocaleDateString('en-KE')}</time>
              </div>
            </a>
          ))}
        </div>
        <a href="/articles" class="view-all">View All Articles →</a>
      </div>
    </section>

    <!-- Tech Tips -->
    <section class="section section-dark">
      <div class="container">
        <h2 class="section-title">💡 Quick Tech Tips</h2>
        <div class="tips-grid">
          {tips.map((tip) => (
            <div class="tip-card">
              <span class="tip-difficulty">{tip.difficulty}</span>
              <h3>{tip.title}</h3>
              <p>{tip.tip?.slice(0, 150)}...</p>
              <span class="tip-category">{tip.category}</span>
            </div>
          ))}
        </div>
        <a href="/tips" class="view-all">View All Tips →</a>
      </div>
    </section>

    <!-- Tech News -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">📰 Tech News</h2>
        <div class="news-list">
          {news.map((item) => (
            <a href={item.sourceUrl || '#'} class="news-item" target="_blank" rel="noopener">
              {item.imageUrl && (
                <img src={item.imageUrl} alt={item.title} class="news-image" loading="lazy" />
              )}
              <div class="news-content">
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <span class="news-source">{item.source}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Daily Tech Facts -->
    <section class="section section-accent">
      <div class="container">
        <h2 class="section-title">🧠 Did You Know?</h2>
        <div class="facts-carousel">
          {facts.map((fact) => (
            <div class="fact-card">
              <h3>{fact.title}</h3>
              <p>{fact.fact}</p>
              <span class="fact-source">{fact.source}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Global Styles */
  :root {
    --ember: #EE6100;
    --teal: #2BB6A3;
    --dark-bg: #0B1F1B;
    --darker-bg: #050d0a;
    --text-primary: #F4F1EA;
    --text-secondary: #A9C4BE;
    --text-muted: #4a6a8a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--dark-bg);
    color: var(--text-primary);
    line-height: 1.6;
  }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

  /* Hero */
  .hero {
    background: linear-gradient(135deg, var(--darker-bg) 0%, var(--dark-bg) 50%, #0a2a24 100%);
    padding: 4rem 2rem;
    text-align: center;
    border-bottom: 2px solid var(--ember);
  }

  .hero h1 {
    font-size: 3rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--ember), var(--teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--teal);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .subtitle { color: var(--text-secondary); font-size: 1rem; }

  /* Sections */
  .section { padding: 3rem 0; }
  .section-dark { background: var(--darker-bg); }
  .section-accent { background: linear-gradient(135deg, #0a2a24, var(--dark-bg)); }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  /* Article Grid */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .article-card {
    background: var(--darker-bg);
    border: 1px solid rgba(43, 182, 163, 0.2);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, border-color 0.2s;
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: var(--ember);
  }

  .article-image { width: 100%; height: 200px; object-fit: cover; }

  .article-content { padding: 1rem; }

  .article-category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--teal);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .article-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .article-card p { font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 0.5rem; }
  .article-card time { font-size: 0.8rem; color: var(--text-muted); }

  /* Tips Grid */
  .tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tip-card {
    background: rgba(43, 182, 163, 0.1);
    border: 1px solid rgba(43, 182, 163, 0.3);
    border-radius: 8px;
    padding: 1rem;
  }

  .tip-difficulty {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--teal);
    color: var(--dark-bg);
    margin-bottom: 0.5rem;
  }

  .tip-card h3 { font-size: 1rem; margin-bottom: 0.5rem; }
  .tip-card p { font-size: 0.85rem; color: var(--text-secondary); }
  .tip-category { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; display: block; }

  /* News List */
  .news-list { display: flex; flex-direction: column; gap: 1rem; }

  .news-item {
    display: flex;
    gap: 1rem;
    background: var(--darker-bg);
    border: 1px solid rgba(238, 97, 0, 0.2);
    border-radius: 8px;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  .news-item:hover { border-color: var(--ember); }
  .news-image { width: 120px; height: 80px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .news-content h3 { font-size: 1rem; margin-bottom: 0.25rem; }
  .news-content p { font-size: 0.85rem; color: var(--text-secondary); }
  .news-source { font-size: 0.75rem; color: var(--ember); }

  /* Facts */
  .facts-carousel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .fact-card {
    background: rgba(238, 97, 0, 0.1);
    border: 1px solid rgba(238, 97, 0, 0.3);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .fact-card h3 { font-size: 1rem; color: var(--ember); margin-bottom: 0.5rem; }
  .fact-card p { font-size: 0.95rem; line-height: 1.6; }
  .fact-source { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; display: block; }

  /* View All Link */
  .view-all {
    display: inline-block;
    color: var(--ember);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .view-all:hover { color: var(--teal); }

  /* Responsive */
  @media (max-width: 768px) {
    .hero h1 { font-size: 2rem; }
    .article-grid { grid-template-columns: 1fr; }
    .news-item { flex-direction: column; }
    .news-image { width: 100%; height: 160px; }
  }
</style>
